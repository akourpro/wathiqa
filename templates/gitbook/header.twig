<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow">
    <base href="{{siteUrl}}" >
    <title>{% if page_title is defined %}{{ page_title }} - {% endif %}{{siteName}}</title>
    <meta name="description" content="{% if subPageDescription is defined %}{{ subPageDescription }}{% else %}{{ siteDescription }}{% endif %}">
    <meta name="keywords" content="{{siteMetaTags}}">
	<meta name="author" content="{{ siteName }}">
    <meta name="publisher" content="{{ siteName }}">
    <meta name="language" content="Arabic">
    <meta name="distribution" content="global">
	

    <meta property="og:type" content="website">
    <meta property="og:title" content="{% if page_title is defined %}{{ page_title }} - {% endif %}{{siteName}}">
    <meta property="og:image" content="{% if basicIMG is defined %}{{ basicIMG }}{% else %}{{siteUrl}}files/images/banner.jpg{% endif %}">
    <meta property="og:image:alt" content="مرحبًا بكم جميعًا" />
    <meta property="og:description" content="{% if subPageDescription is defined %}{{ subPageDescription }}{% else %}{{ siteDescription }}{% endif %}">
    <meta property="og:site_name" content="{{siteName}}">
	
    <link rel="alternate" hreflang="ar" href="{{ siteUrl }}">
    <link rel="sitemap" type="application/xml" title="Sitemap" href="{{ siteUrl }}sitemap.xml">

    <link href="{{ templatePath }}/assets/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ templatePath }}/assets/css/style.css">
    <script src="js/jquery-3.7.1.min.js"></script>

    <link rel="stylesheet" href="css/remixicon/remixicon.css" />
    <link href="css/fontawesome.css" rel="stylesheet">
    <link href="css/fontawesome/css/fontawesome_all.css" rel="stylesheet">
    <script src="js/sweetalert2.all.min.js"></script>
    <script src="js/js.cookie.min.js"></script>
    <script src="js/functions.js?v=15092024"></script>
    {% if schema is defined %}
    <script type="application/ld+json">
	{
	  "@context": "https://schema.org",
	  "@type": "Article",
	  "headline": "{% if page_title is defined %}{{ page_title }} - {% endif %}{{siteName}}",
	  "description": "{% if subPageDescription is defined %}{{ subPageDescription }}{% else %}{{ siteDescription }}{% endif %}",
	  "author": {
		"@type": "Person",
		"name": "{{ siteName }}"
	  },
	  "publisher": {
		"@type": "Organization",
		"name": "{{ siteName }}",
		"logo": {
		  "@type": "ImageObject",
		  "url": "{{ siteUrl }}files/images/logo.png"
		}
	  },
	  "datePublished": "{{schema.datePublished}}",
	  "dateModified": "{{schema.dateModified}}",
	  "mainEntityOfPage": {
		"@type": "WebPage",
		"@id": "{{schema.slug}}"
	  },
	  "image": {
		"@type": "ImageObject",
		"url": "{% if basicIMG is defined %}{{ basicIMG }}{% else %}{{siteUrl}}files/images/banner.jpg{% endif %}",
		"width": 1200,
		"height": 800
	  }
	}
	</script>
    {% endif %}

  </head>
  <body>
    <div class="sidebar" id="sidebar">
      <div class="sidebar-header border-bottom p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2 logo-section" onclick='location.href = "{{siteUrl}}";'>
            <img src="files/images/logo.png" class="logo">
            <span class="fw-semibold">{{siteName}}</span>
          </div>
          <button id="toggleSidebar" class="btn btn-light btn-sm">
            <i class="w-4 h-4 fa-regular fa-right"></i>
          </button>
        </div>
        <div class="mt-3 search-container">
          <div class="position-relative">
            <form method="GET" action="search">
                <i class="fa-regular fa-magnifying-glass search-icon"></i>
                <input type="text" name="search" required class="form-control ps-4" placeholder="البحث...">
            </form>
          </div>
        </div>
      </div>